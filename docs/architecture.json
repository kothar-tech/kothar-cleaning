{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Kothar Cleaning Services: site architecture",
    "output": "docs/architecture.html",
    "quality_profile": "showcase",
    "legend": {
      "mode": "all",
      "entries": {
        "frontend": { "label": "Client (hydrated)" },
        "backend": { "label": "Server code" },
        "database": { "label": "Content file" },
        "cloud": { "label": "Shared UI kit" },
        "security": { "label": "Logic (lib/)" },
        "messagebus": { "label": "Reel pipeline" },
        "external": { "label": "Outside site" }
      }
    }
  },
  "components": [
    { "id": "site", "type": "database", "label": "content/site.ts", "sublabel": "services, steps, FAQ", "tag": "REAL", "pos": [30, 160], "size": [170, 64] },
    { "id": "visitor", "type": "external", "label": "Visitor", "sublabel": "phone or desktop", "pos": [30, 290], "size": [170, 64] },
    { "id": "hf", "type": "messagebus", "label": "video/ project", "sublabel": "HyperFrames, 3 scenes", "pos": [30, 550], "size": [170, 64] },

    { "id": "server", "type": "backend", "label": "Server sections", "sublabel": "Hero, Services, Products", "tag": "SERVER", "pos": [310, 160], "size": [170, 64] },
    { "id": "page", "type": "backend", "label": "page.tsx + layout", "sublabel": "composes 13 sections", "tag": "STATIC", "pos": [310, 290], "size": [170, 64] },
    { "id": "islands", "type": "frontend", "label": "Client islands", "sublabel": "Header, Process, FAQ", "tag": "CLIENT", "pos": [310, 420], "size": [170, 64] },
    { "id": "mp4", "type": "messagebus", "label": "public/video", "sublabel": "reel.mp4 788 KB + poster", "pos": [310, 550], "size": [170, 64] },

    { "id": "placeholders", "type": "database", "label": "placeholders.ts", "sublabel": "sample rates and stats", "tag": "FLAGGED", "pos": [590, 30], "size": [170, 64] },
    { "id": "pricing", "type": "security", "label": "lib/pricing.ts", "sublabel": "pure estimate()", "pos": [590, 160], "size": [170, 64] },
    { "id": "estimator", "type": "frontend", "label": "QuoteEstimator", "sublabel": "live price range", "tag": "CLIENT", "pos": [590, 290], "size": [170, 64] },
    { "id": "prims", "type": "cloud", "label": "UI + graphics kit", "sublabel": "Button, Reveal, Sparkle", "pos": [590, 420], "size": [170, 64] },
    { "id": "band", "type": "frontend", "label": "BrandReelBand", "sublabel": "plays only on screen", "tag": "CLIENT", "pos": [590, 550], "size": [170, 64] },

    { "id": "validation", "type": "security", "label": "lib/validation.ts", "sublabel": "zod, shared schema", "pos": [870, 160], "size": [170, 64] },
    { "id": "contact", "type": "frontend", "label": "Contact form", "sublabel": "validates on blur", "tag": "CLIENT", "pos": [870, 290], "size": [170, 64] },
    { "id": "mailto", "type": "external", "label": "mailto fallback", "sublabel": "pre-filled email draft", "pos": [870, 420], "size": [170, 64] },

    { "id": "api", "type": "backend", "label": "/api/quote", "sublabel": "honeypot + rate limit", "tag": "SERVER", "pos": [1150, 290], "size": [170, 64] },
