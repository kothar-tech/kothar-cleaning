    { "id": "site-to-server", "from": "site", "to": "server", "label": "facts" },
    { "id": "page-to-islands", "from": "page", "to": "islands", "label": "hydrate" },
    { "id": "page-to-estimator", "from": "page", "to": "estimator", "label": "mounts" },
    { "id": "prims-to-islands", "from": "prims", "to": "islands", "label": "UI kit" },
    { "id": "prims-to-estimator", "from": "prims", "to": "estimator", "label": "UI kit" },
    { "id": "placeholders-to-pricing", "from": "placeholders", "to": "pricing", "label": "sample rates", "variant": "dashed" },
    { "id": "pricing-to-estimator", "from": "pricing", "to": "estimator", "label": "estimate()" },
    { "id": "estimator-to-contact", "from": "estimator", "to": "contact", "label": "prefill event", "variant": "emphasis" },
    { "id": "validation-to-contact", "from": "validation", "to": "contact", "label": "validate", "variant": "security" },
    { "id": "validation-to-api", "from": "validation", "to": "api", "label": "same schema", "variant": "security", "fromSide": "right", "toSide": "top" },
    { "id": "contact-to-api", "from": "contact", "to": "api", "label": "POST JSON", "variant": "emphasis" },
    { "id": "api-to-resend", "from": "api", "to": "resend", "label": "send" },
    { "id": "contact-to-mailto", "from": "contact", "to": "mailto", "label": "on failure", "variant": "dashed" },
    { "id": "hf-to-mp4", "from": "hf", "to": "mp4", "label": "render" },
    { "id": "mp4-to-band", "from": "mp4", "to": "band", "label": "plays" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Page order",
      "items": [
        "Hero, StatsBar, Services, AdditionalServices",
        "QuoteEstimator, Process, Products, WhyKothar",
        "BrandReelBand, Testimonials, GetAQuote, Faq, Contact",
        "Header, UtilityBar, Footer and StickyBookBar wrap the page in layout.tsx"
      ]
    },
    {
      "dot": "emerald",
      "title": "Quote flow",
      "items": [
        "Service cards fire kothar:select-service to preselect the estimator",
        "Request this quote fires kothar:quote-prefill, which fills the form",
        "In development the API logs the request instead of emailing it",
        "In production without a key it answers 503 and the form offers a mailto draft"
      ]
    },
    {
      "dot": "amber",
      "title": "Content honesty",
      "items": [
        "site.ts holds only facts from the brochure",
        "placeholders.ts holds every invented number, review and rate",
        "npm run build lists outstanding TODO(client) items",
        "STRICT_PLACEHOLDERS=1 fails the build until they are real"
      ]
    },
    {
      "dot": "violet",
      "title": "Reel pipeline",
      "items": [
        "10 s loop rendered at 1080p by HyperFrames, compressed to 720p with ffmpeg",
        "Starts and ends on brand blue so the loop has no seam",
        "Pauses off screen, stays on its poster under reduced motion, has a pause button"
      ]
    }
  ]
}
